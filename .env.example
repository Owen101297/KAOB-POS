# Copia este archivo como .env y completa los valores reales.
# Las credenciales NUNCA se commitean al repositorio.

# PostgreSQL en Railway (staging para desarrollo local)
DATABASE_URL="postgresql://usuario:password@host:puerto/basedatos?sslmode=require"

# Base auxiliar usada por `prisma migrate dev` para aplicar/calcular migraciones
SHADOW_DATABASE_URL="postgresql://usuario:password@host:puerto/shadow?sslmode=require"

# Acceso compartido al POS (obligatorio en producción; se configura en el entorno de Coolify).
# Usa un usuario y una contraseña única de al menos 16 caracteres. El usuario no puede contener ":".
# Nunca subas sus valores reales al repositorio.
# En desarrollo local, si ambos quedan vacíos, el acceso no se solicita.
KAOB_POS_AUTH_USER=
KAOB_POS_AUTH_PASSWORD=

# Pasarelas de pago del checkout de /tienda (spec 002-tienda-venta).
# Staging usa llaves de PRUEBAS (pub_test_/prv_test_); las llaves live solo en
# Coolify (gestor cifrado), nunca en Git. Sin llaves, la tienda usa WhatsApp.
WOMPI_ENTORNO=sandbox                 # sandbox|produccion
WOMPI_PUBLIC_KEY=                     # pub_test_... (Web Checkout)
WOMPI_PRIVATE_KEY=                    # prv_test_... (consulta de transacciones, servidor)
WOMPI_INTEGRITY_SECRET=               # Secreto de integridad (firma del Web Checkout)
WOMPI_EVENTS_SECRET=                  # Secreto de eventos (checksum de webhooks)
BOLD_API_KEY=                         # Llave de identidad de Bold (API Link de pagos)
TIENDA_URL=https://kaob.owenai.uk     # Base para redirect/callback de pasarelas
