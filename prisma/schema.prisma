generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Configuración global de la tienda (singleton: id = 1)
model Configuracion {
  id             Int      @id @default(autoincrement())
  nombreTienda   String   @default("Mi Tienda")
  nit            String?
  direccion      String?
  telefono       String?
  ciudad         String?  @default("Bogotá")
  email          String?
  regimen        String?  @default("Responsable de IVA")
  mensajeTicket  String?  @default("¡Gracias por su compra!")
  pieTicket      String?  @default("Conserve este ticket para cambios o garantías (plazo máximo 30 días).")
  logoUrl        String?
  // Meta de ventas diaria en COP
  metaDiaria     Int      @default(1000000)
  // Regla de puntos: cada X pesos gastados = 1 punto
  puntosPorMonto Int      @default(10000)
  updatedAt      DateTime @updatedAt

  @@map("configuracion")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum Genero {
  DAMA
  CABALLERO
  NINO
  UNISEX

  @@map("genero")
}

enum Calidad {
  PREMIUM
  ALTA
  ESTANDAR
  ECONOMICA

  @@map("calidad")
}

enum TipoMovimiento {
  INICIAL
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
  TRASLADO_SALIDA
  TRASLADO_ENTRADA
  COMPRA
  DEVOLUCION
  VENTA
  DEVOLUCION_CLIENTE

  @@map("tipo_movimiento")
}

enum TipoVenta {
  VENTA
  REMISION
  COTIZACION

  @@map("tipo_venta")
}

enum EstadoVenta {
  COMPLETADA
  PENDIENTE
  ANULADA

  @@map("estado_venta")
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  PUNTOS
  OTRO
  CREDITO
  ADDI
  SISTECREDITO

  @@map("metodo_pago")
}

enum TipoDocumento {
  CC
  NIT
  OTRO

  @@map("tipo_documento")
}

enum Rol {
  ADMIN
  GERENTE
  CAJERO
  VENDEDOR
  BODEGUERO

  @@map("rol")
}

// ─────────────────────── CATÁLOGOS BASE ──────────────────────

model Bodega {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  direccion   String?
  esPrincipal Boolean  @default(false)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks       StockBodega[]
  movimientosOrigen  MovimientoInventario[] @relation("MovOrigen")
  movimientosDestino MovimientoInventario[] @relation("MovDestino")
  trasladosSalida    Traslado[]             @relation("TrasladosOrigen")
  trasladosEntrada   Traslado[]             @relation("TrasladosDestino")
  ventas             Venta[]
  sesionesCaja       SesionCaja[]
  compras            Compra[]
  ordenesCompra      OrdenCompra[]
  planesSepare       PlanSepare[]

  @@map("bodegas")
}

model Marca {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activa Boolean @default(true)

  productos Producto[]

  @@map("marcas")
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  padreId Int?
  padre  Categoria?  @relation("CategoriaJerarquia", fields: [padreId], references: [id])
  hijas  Categoria[] @relation("CategoriaJerarquia")

  productos Producto[]

  @@map("categorias")
}

model GrupoTalla {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  tallas Talla[]

  @@map("grupos_talla")
}

model Talla {
  id     Int        @id @default(autoincrement())
  grupoId Int
  grupo  GrupoTalla @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  valor  String
  orden  Int        @default(0)

  variantes Variante[]

  @@unique([grupoId, valor])
  @@map("tallas")
}

model Color {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  hex    String?

  variantes Variante[]

  @@map("colores")
}

// ───────────────────── PRODUCTOS Y VARIANTES ──────────────────

model Producto {
  id          Int      @id @default(autoincrement())
  referencia  String   @unique
  nombre      String
  descripcion String?
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  marcaId     Int?
  marca       Marca?    @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  genero      Genero?
  material    String?
  calidad     Calidad?
  temporada   String?
  costo       Int      @default(0)
  precioBase  Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variantes Variante[]

  @@map("productos")
}

model Variante {
  id             Int      @id @default(autoincrement())
  productoId     Int
  producto       Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  colorId        Int
  color          Color     @relation(fields: [colorId], references: [id], onDelete: Restrict)
  tallaId        Int
  talla          Talla     @relation(fields: [tallaId], references: [id], onDelete: Restrict)
  sku            String    @unique
  precioOverride Int?
  activa         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  stocks         StockBodega[]
  movimientos    MovimientoInventario[]
  trasladosDetalle TrasladoDetalle[]
  ventaItems     VentaItem[]
  compraItems    CompraItem[]
  ordenCompraDetalles OrdenCompraDetalle[]
  planSepareItems PlanSepareItem[]
  pedidoOnlineItems PedidoOnlineItem[]

  @@unique([productoId, colorId, tallaId])
  @@map("variantes")
}

model StockBodega {
  id         Int     @id @default(autoincrement())
  varianteId Int
  variante   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  bodegaId   Int
  bodega     Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  cantidad   Int     @default(0)
  minimo     Int     @default(0)

  @@unique([varianteId, bodegaId])
  @@index([bodegaId])
  @@map("stock_bodega")
}

// ───────────────── INVENTARIO: MOVIMIENTOS ────────────────────

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  varianteId      Int
  variante        Variante       @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  tipo            TipoMovimiento
  cantidad        Int
  bodegaOrigenId  Int?
  bodegaOrigen    Bodega?        @relation("MovOrigen", fields: [bodegaOrigenId], references: [id], onDelete: SetNull)
  bodegaDestinoId Int?
  bodegaDestino   Bodega?        @relation("MovDestino", fields: [bodegaDestinoId], references: [id], onDelete: SetNull)
  costoUnitario   Int?
  nota            String?
  trasladoId      Int?
  refDocumento    String?
  createdAt       DateTime       @default(now())

  traslado Traslado? @relation(fields: [trasladoId], references: [id], onDelete: SetNull)

  @@index([varianteId])
  @@index([createdAt])
  @@map("movimientos_inventario")
}

model Traslado {
  id              Int      @id @default(autoincrement())
  bodegaOrigenId  Int
  bodegaOrigen    Bodega   @relation("TrasladosOrigen", fields: [bodegaOrigenId], references: [id], onDelete: Restrict)
  bodegaDestinoId Int
  bodegaDestino   Bodega   @relation("TrasladosDestino", fields: [bodegaDestinoId], references: [id], onDelete: Restrict)
  nota            String?
  createdAt       DateTime @default(now())

  detalles    TrasladoDetalle[]
  movimientos MovimientoInventario[]

  @@map("traslados")
}

model TrasladoDetalle {
  id         Int      @id @default(autoincrement())
  trasladoId Int
  traslado   Traslado @relation(fields: [trasladoId], references: [id], onDelete: Cascade)
  varianteId Int
  variante   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  cantidad   Int

  @@unique([trasladoId, varianteId])
  @@map("traslados_detalle")
}

// ───────────────────────── CONTACTOS ────────────────────────────

model Cliente {
  id           Int             @id @default(autoincrement())
  nombre       String
  tipoDoc      TipoDocumento   @default(CC)
  documento    String?
  telefono     String?
  direccion    String?
  ciudad       String?
  email        String?
  cupoCredito  Int             @default(0)
  diasCredito  Int             @default(0)
  notas        String?
  activo       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  ventas             Venta[]
  creditos           CreditoCliente[]
  planesSepare       PlanSepare[]
  movimientosPuntos  MovimientoPuntos[]
  giftCards          GiftCard[]

  @@unique([tipoDoc, documento])
  @@index([nombre])
  @@index([telefono])
  @@map("clientes")
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  nit       String?
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compras       Compra[]
  ordenesCompra OrdenCompra[]

  @@index([nombre])
  @@map("proveedores")
}

model Vendedor {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String?
  comisionPct Float    @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ventas      Venta[]

  @@index([nombre])
  @@map("vendedores")
}

model Domiciliario {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventas    Venta[]

  @@index([nombre])
  @@map("domiciliarios")
}

// ───────────────────────── VENTAS Y CAJA ────────────────────────

model Venta {
  id           Int        @id @default(autoincrement())
  consecutivo  Int        @unique
  tipo         TipoVenta
  estado       EstadoVenta @default(PENDIENTE)
  clienteId    Int?
  cliente      Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  vendedorId   Int?
  vendedor     Vendedor?   @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  domiciliarioId Int?
  domiciliario Domiciliario? @relation(fields: [domiciliarioId], references: [id], onDelete: SetNull)
  bodegaId     Int
  bodega       Bodega      @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  subtotal     Int        @default(0)
  descuento    Int        @default(0)
  total        Int        @default(0)
  nota         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  items        VentaItem[]
  pagos        PagoVenta[]
  credito      CreditoCliente?

  @@index([createdAt])
  @@index([clienteId])
  @@index([estado])
  @@map("ventas")
}

model VentaItem {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  varianteId     Int
  variante       Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  cantidad       Int
  precioUnitario Int
  costoUnitario  Int
  descuento      Int      @default(0)
  subtotal       Int

  @@map("ventas_items")
}

model PagoVenta {
  id           Int                   @id @default(autoincrement())
  ventaId      Int
  venta        Venta                 @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodo       MetodoPago
  monto        Int
  referencia   String?
  desembolsado Boolean               @default(false)
  desembolsoId Int?
  desembolso   DesembolsoPlataforma? @relation(fields: [desembolsoId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())

  @@index([metodo])
  @@index([desembolsado])
  @@map("ventas_pagos")
}

model SesionCaja {
  id             Int      @id @default(autoincrement())
  baseInicial    Int      @default(0)
  estado         String   @default("ABIERTA") // ABIERTA, CERRADA
  bodegaId       Int?
  bodega         Bodega?  @relation(fields: [bodegaId], references: [id], onDelete: SetNull)
  openedAt       DateTime @default(now())
  closedAt       DateTime?

  movimientos    MovimientoCaja[]
  @@map("sesiones_caja")
}

model MovimientoCaja {
  id            Int      @id @default(autoincrement())
  sesionId      Int
  sesion        SesionCaja @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  tipo          String   // INGRESO_BASE, RETIRO, SUPLIDO, VENTA_EFECTIVO, OTRO
  monto         Int
  referencia    String?
  ventaId       Int?
  createdAt     DateTime @default(now())

  @@index([sesionId])
  @@map("movimientos_caja")
}

// ───────────────────────── COMPRAS Y PROVEEDORES ────────────────────────

model Compra {
  id             Int          @id @default(autoincrement())
  consecutivo    Int          @unique
  numeroFactura  String?
  proveedorId    Int
  proveedor      Proveedor    @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  bodegaId       Int
  bodega         Bodega       @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  subtotal       Int          @default(0)
  impuesto       Int          @default(0)
  total          Int          @default(0)
  estado         EstadoVenta  @default(COMPLETADA) // COMPLETADA, ANULADA
  nota           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items          CompraItem[]
  pagos          PagoCompra[]

  @@index([proveedorId])
  @@index([createdAt])
  @@map("compras")
}

model CompraItem {
  id             Int      @id @default(autoincrement())
  compraId       Int
  compra         Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  varianteId     Int
  variante       Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  cantidad       Int
  costoUnitario  Int
  subtotal       Int

  @@map("compras_items")
}

model PagoCompra {
  id         Int        @id @default(autoincrement())
  compraId   Int
  compra     Compra     @relation(fields: [compraId], references: [id], onDelete: Cascade)
  metodo     MetodoPago
  monto      Int
  referencia String?
  createdAt  DateTime   @default(now())

  @@map("compras_pagos")
}

model OrdenCompra {
  id          Int                  @id @default(autoincrement())
  consecutivo Int                  @unique
  proveedorId Int
  proveedor   Proveedor            @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  bodegaId    Int
  bodega      Bodega               @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  total       Int                  @default(0)
  estado      String               @default("PENDIENTE") // PENDIENTE, RECIBIDA, CANCELADA
  nota        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  detalles    OrdenCompraDetalle[]

  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
  id          Int         @id @default(autoincrement())
  ordenId     Int
  orden       OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  varianteId  Int
  variante    Variante    @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  cantidad    Int
  costoEstimado Int
  subtotal    Int

  @@map("ordenes_compra_detalle")
}

// ───────────────────────── CRÉDITO Y CARTERA ─────────────────────────

model CreditoCliente {
  id               Int            @id @default(autoincrement())
  consecutivo      Int            @unique
  clienteId        Int
  cliente          Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  ventaId          Int?           @unique
  venta            Venta?         @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  montoTotal       Int
  saldoPendiente   Int
  diasCredito      Int            @default(30)
  fechaVencimiento DateTime
  estado           String         @default("PENDIENTE") // PENDIENTE, PAGADO, ANULADO
  nota             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  abonos           AbonoCredito[]

  @@index([clienteId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@map("creditos_cliente")
}

model AbonoCredito {
  id          Int            @id @default(autoincrement())
  creditoId   Int
  credito     CreditoCliente @relation(fields: [creditoId], references: [id], onDelete: Cascade)
  monto       Int
  metodo      MetodoPago     @default(EFECTIVO)
  referencia  String?
  nota        String?
  createdAt   DateTime       @default(now())

  @@index([creditoId])
  @@map("abonos_credito")
}

// ───────────────────────── PLAN SEPARE ─────────────────────────

model PlanSepare {
  id               Int                @id @default(autoincrement())
  consecutivo      Int                @unique
  clienteId        Int
  cliente          Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  bodegaId         Int
  bodega           Bodega             @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  total            Int
  saldoPendiente   Int
  fechaLimite      DateTime
  estado           String             @default("ACTIVO") // ACTIVO, ENTREGADO, CANCELADO
  nota             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  items            PlanSepareItem[]
  abonos           AbonoPlanSepare[]

  @@index([clienteId])
  @@index([estado])
  @@map("planes_separe")
}

model PlanSepareItem {
  id             Int        @id @default(autoincrement())
  planSepareId   Int
  planSepare     PlanSepare @relation(fields: [planSepareId], references: [id], onDelete: Cascade)
  varianteId     Int
  variante       Variante   @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  cantidad       Int
  precioUnitario Int
  subtotal       Int

  @@map("planes_separe_items")
}

model AbonoPlanSepare {
  id           Int        @id @default(autoincrement())
  planSepareId Int
  planSepare   PlanSepare @relation(fields: [planSepareId], references: [id], onDelete: Cascade)
  monto        Int
  metodo       MetodoPago @default(EFECTIVO)
  referencia   String?
  nota         String?
  createdAt    DateTime   @default(now())

  @@index([planSepareId])
  @@map("abonos_plan_separe")
}

// ───────────────────────── PUNTOS Y FIDELIZACIÓN ─────────────────────────

model MovimientoPuntos {
  id               Int      @id @default(autoincrement())
  clienteId        Int
  cliente          Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo             String   // ACUMULACION, REDENCION, AJUSTE
  puntos           Int
  saldoResultante  Int
  referencia       String?
  nota             String?
  createdAt        DateTime @default(now())

  @@index([clienteId])
  @@map("movimientos_puntos")
}

// ───────────────────────── PROMOCIONES Y DESCUENTOS ─────────────────────────

model Promocion {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  tipo        String    // PORCENTAJE, MONTO_FIJO
  valor       Int
  montoMinimo Int       @default(0)
  activa      Boolean   @default(true)
  fechaInicio DateTime?
  fechaFin    DateTime?
  createdAt   DateTime  @default(now())

  @@map("promociones")
}

// ───────────────────────── TARJETAS DE REGALO (GIFT CARDS) ─────────────────────────

model GiftCard {
  id               Int       @id @default(autoincrement())
  codigo           String    @unique
  montoInicial     Int
  saldoActual      Int
  clienteId        Int?
  cliente          Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  estado           String    @default("ACTIVA") // ACTIVA, AGOTADA, VENCIDA
  fechaVencimiento DateTime?
  createdAt        DateTime  @default(now())

  @@index([codigo])
  @@map("gift_cards")
}

// ───────────────────────── AUDITORÍA DEL SISTEMA ─────────────────────────

model Auditoria {
  id          Int      @id @default(autoincrement())
  modulo      String   // VENTAS, COMPRAS, INVENTARIO, CAJA, PRECIOS, CONTACTOS, BANCOS, GASTOS, CONFIGURACION, FIDELIZACION
  accion      String   // CREAR, EDITAR, ANULAR, AJUSTE, CIERRE, ELIMINAR, RESTAURAR
  entidad     String   // Ej: "Venta #1004", "Variante REF-01 Rojo M"
  entidadId   String?
  descripcion String
  detalles    String?  // JSON string con metadata o diferencias antes/después
  usuario     String   @default("Administrador")
  usuarioId   String?
  usuarioRel  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  ip          String?
  createdAt   DateTime @default(now())

  @@index([modulo])
  @@index([accion])
  @@index([createdAt])
  @@map("auditorias")
}

// ───────────────────────── BANCOS Y TESORERÍA ─────────────────────────

model CuentaBancaria {
  id           Int      @id @default(autoincrement())
  nombre       String   @unique // Ej: Bancolombia Ahorros, Nequi Negocio, Daviplata
  tipo         String   @default("AHORROS") // AHORROS, CORRIENTE, BILLETERA_DIGITAL, TARJETA
  numeroCuenta String?
  titular      String?
  saldoActual  Int      @default(0) // En COP
  activa       Boolean  @default(true)
  color        String?  @default("#2563eb")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movimientos    MovimientoBancario[]
  conciliaciones ConciliacionBancaria[]
  gastos         Gasto[]
  desembolsos    DesembolsoPlataforma[]

  @@map("cuentas_bancarias")
}

model DesembolsoPlataforma {
  id                 Int             @id @default(autoincrement())
  consecutivo        Int             @unique
  plataforma         String          // ADDI, SISTECREDITO, BOLD, OTRO
  fecha              DateTime        @default(now())
  montoBruto         Int             // Total ventas cubiertas
  comision           Int             @default(0) // Comisión descontada por la plataforma
  retenciones        Int             @default(0) // ReteFuente/ReteICA
  montoNeto          Int             // Dinero neto transferido al banco (montoBruto - comision - retenciones)
  cuentaBancariaId   Int?
  cuentaBancaria     CuentaBancaria? @relation(fields: [cuentaBancariaId], references: [id], onDelete: SetNull)
  referenciaBancaria String?         // N° de transferencia o comprobante bancario
  estado             String          @default("LIQUIDADO") // LIQUIDADO, ANULADO
  nota               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  pagos              PagoVenta[]

  @@index([plataforma])
  @@index([fecha])
  @@index([estado])
  @@map("desembolsos_plataforma")
}

model MovimientoBancario {
  id               Int            @id @default(autoincrement())
  cuentaBancariaId Int
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  tipo             String         // INGRESO, EGRESO, TRANSFERENCIA_ENTRADA, TRANSFERENCIA_SALIDA, COMISION_BANCARIA, AJUSTE
  monto            Int            // Monto absoluto > 0
  saldoResultante  Int
  fecha            DateTime       @default(now())
  referencia       String?
  concepto         String
  categoria        String         @default("OTRO") // VENTA, COMPRA, GASTO, TRASLADO, COMISION, AJUSTE, OTRO
  conciliado       Boolean        @default(false)
  conciliacionId   Int?
  conciliacion     ConciliacionBancaria? @relation(fields: [conciliacionId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([cuentaBancariaId])
  @@index([fecha])
  @@index([conciliado])
  @@map("movimientos_bancarios")
}

model ConciliacionBancaria {
  id               Int            @id @default(autoincrement())
  cuentaBancariaId Int
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id], onDelete: Cascade)
  fechaCorte       DateTime
  saldoExtracto    Int            // Saldo según el banco
  saldoLibros      Int            // Saldo registrado en el sistema
  diferencia       Int            // saldoLibros - saldoExtracto
  estado           String         @default("PENDIENTE") // PENDIENTE, CUADRADA, CON_DIFERENCIA
  notas            String?
  cerradaEn        DateTime?
  createdAt        DateTime       @default(now())

  movimientos      MovimientoBancario[]

  @@index([cuentaBancariaId])
  @@map("conciliaciones_bancarias")
}

// ───────────────────────── GASTOS OPERATIVOS ─────────────────────────

model Gasto {
  id               Int             @id @default(autoincrement())
  concepto         String
  categoria        String          @default("VARIOS") // ARRIENDO, SERVICIOS, NOMINA, SUMINISTROS, MANTENIMIENTO, TRANSPORTE, PUBLICIDAD, IMPUESTOS, VARIOS
  monto            Int
  metodoPago       MetodoPago      @default(EFECTIVO)
  cuentaBancariaId Int?
  cuentaBancaria   CuentaBancaria? @relation(fields: [cuentaBancariaId], references: [id], onDelete: SetNull)
  comprobante      String?
  fecha            DateTime        @default(now())
  nota             String?
  estado           String          @default("REGISTRADO") // REGISTRADO, ANULADO
  createdAt        DateTime        @default(now())

  @@index([categoria])
  @@index([fecha])
  @@index([estado])
  @@map("gastos")
}

// ───────────────────────── TIENDA ONLINE (CRO) ─────────────────────────

model PedidoOnline {
  id                  Int      @id @default(autoincrement())
  consecutivo         Int      @unique
  clienteNombre       String
  clienteTelefono     String
  ciudad              String
  direccion           String
  notas               String?
  metodoFinanciacion  String   @default("CONTADO") // CONTADO, PLAN_SEPARE, ADDI, SISTECREDITO
  subtotal            Int
  total               Int
  estado              String   @default("PENDIENTE") // PENDIENTE, EMPACADO, DESPACHADO, ENTREGADO, CANCELADO
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items PedidoOnlineItem[]

  @@index([estado])
  @@index([createdAt])
  @@map("pedidos_online")
}

model PedidoOnlineItem {
  id             Int           @id @default(autoincrement())
  pedidoId       Int
  pedido         PedidoOnline  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  varianteId     Int?
  variante       Variante?     @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  nombreProducto String
  referencia     String?
  tallaValor     String
  colorNombre    String
  cantidad       Int
  precioUnitario Int
  subtotal       Int

  @@map("pedidos_online_items")
}

model LeadTienda {
  id             Int       @id @default(autoincrement())
  nombre         String?
  telefono       String?
  email          String?
  origen         String    // EXIT_INTENT, CARRITO_ABANDONADO, NEWSLETTER
  cuponOfrecido  String?
  descuentoPct   Int?
  contactado     Boolean   @default(false)
  carritoResumen String?
  createdAt      DateTime  @default(now())

  @@index([contactado])
  @@index([createdAt])
  @@map("leads_tienda")
}

// ───────────────────────── AUTENTICACIÓN Y USUARIOS ─────────────────────────

model Usuario {
  id              String    @id @default(cuid())
  email           String    @unique
  nombre          String
  passwordHash    String?   // null si solo usa Google OAuth
  imagen          String?
  rol             Rol       @default(CAJERO)
  activo          Boolean   @default(true)
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  auditoriasCreadas    Auditoria[]

  @@index([email])
  @@map("usuarios")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  usuario           Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("cuentas_auth")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  usuario      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sesiones_auth")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("tokens_verificacion")
}



